# Copy to .env for local development. Never commit real values.

ASYNCFFLOW_ENVIRONMENT=development
ASYNCFFLOW_DATABASE_URL=sqlite:///./asyncflow.db
ASYNCFFLOW_REDIS_URL=redis://localhost:6379/0
ASYNCFFLOW_STORAGE_DIR=storage
ASYNCFFLOW_MAX_UPLOAD_BYTES=10485760
ASYNCFFLOW_JOB_MAX_RETRIES=3
ASYNCFFLOW_JOB_RETRY_BACKOFF_SECONDS=2
ASYNCFFLOW_JOB_STALE_AFTER_SECONDS=300
ASYNCFFLOW_DATABASE_CONNECT_ATTEMPTS=10
ASYNCFFLOW_DATABASE_CONNECT_DELAY_SECONDS=1.5
